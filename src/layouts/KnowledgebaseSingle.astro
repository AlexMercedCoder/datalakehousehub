---
import { withSlash } from "@/lib/utils/withSlash";
import { render } from "astro:content";
import { markdownify } from "@/lib/utils/textConverter";

export interface Props {
  data: any;
  relatedTerms?: any[];
}

const { data, relatedTerms = [] } = Astro.props;
const { title, description } = data.data;
const { Content } = await render(data);
---

<section class="section pt-10">
  <div class="container max-w-4xl">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-text/70 dark:text-darkmode-text/70">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="hover:text-primary transition-colors">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/knowledgebase/" class="hover:text-primary transition-colors">Knowledge Base</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-dark dark:text-darkmode-dark" aria-current="page">
          {title}
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-10 text-center">
      <span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary dark:text-darkmode-primary mb-4">
        Glossary Entry
      </span>
      <h1 set:html={markdownify(title)} class="h2 lg:h1 font-extrabold tracking-tight text-dark dark:text-darkmode-dark" />
      {
        description && (
          <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-text/85 dark:text-darkmode-text/85">
            {description}
          </p>
        )
      }
    </header>

    <!-- Main Content -->
    <article class="content prose prose-lg dark:prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary hover:prose-a:text-primary/80 mb-14">
      <Content />
    </article>

    <!-- Related Terms -->
    {
      relatedTerms.length > 0 && (
        <div class="mt-14 border-t border-border pt-10 dark:border-darkmode-border">
          <h2 class="h4 mb-6 text-dark dark:text-darkmode-dark font-bold">Related Terms</h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {relatedTerms.map((term: any) => (
              <a
                href={withSlash(`/knowledgebase/${term.id}`)}
                class="group block rounded-xl border border-border bg-white p-5 transition hover:border-primary hover:shadow-md dark:border-darkmode-border dark:bg-theme-dark"
              >
                <h3 class="font-bold text-dark group-hover:text-primary dark:text-darkmode-dark text-base mb-2">
                  {term.data.title}
                </h3>
                {term.data.description && (
                  <p class="text-xs text-text/75 dark:text-darkmode-text/75 line-clamp-2">
                    {term.data.description}
                  </p>
                )}
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- Navigation Back -->
    <div class="mt-12 text-center">
      <a
        href="/knowledgebase/"
        class="btn btn-outline-primary text-sm font-semibold inline-flex items-center gap-2"
      >
        <span>&larr;</span> Back to All Terms
      </a>
    </div>
  </div>
</section>
