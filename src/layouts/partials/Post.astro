---
import config from "@/config/config.json";
import dateFormat from "@/lib/utils/dateFormat";

const { post } = Astro.props;
const { blog_folder } = config.settings;
---

<a
  href={`/${blog_folder}/${post.id}`}
  class="surface surface-hover group flex h-full flex-col overflow-hidden"
>
  <div class="relative overflow-hidden">
    <img
      src={`/open-graph/${post.id}.png`}
      alt={post.data.title}
      width={1200}
      height={630}
      loading="lazy"
      class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
    {
      post.data.category && (
        <span class="absolute left-3 top-3 rounded-full bg-body/90 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.12em] text-primary backdrop-blur-sm dark:bg-darkmode-body/90 dark:text-darkmode-primary">
          {post.data.category}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6">
    {
      post.data.date && (
        <time
          datetime={new Date(post.data.date).toISOString()}
          class="text-xs font-semibold uppercase tracking-wider text-text/70 dark:text-darkmode-text/70"
        >
          {dateFormat(post.data.date)}
        </time>
      )
    }
    <h3
      class="mt-2 font-secondary text-lg font-bold leading-snug text-dark transition-colors group-hover:text-primary dark:text-darkmode-dark dark:group-hover:text-darkmode-primary"
    >
      {post.data.title}
    </h3>
    {
      post.data.description && (
        <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-text dark:text-darkmode-text">
          {post.data.description}
        </p>
      )
    }
    <span
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-primary dark:text-darkmode-primary"
    >
      Read more
      <svg
        class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>
</a>
