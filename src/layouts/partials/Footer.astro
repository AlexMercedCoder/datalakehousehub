---
import { Image } from "astro:assets";
import Social from "@/components/Social.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { markdownify } from "@/lib/utils/textConverter";

const { footer_content, copyright } = config.params;
---

<footer
  class="border-t border-border bg-theme-light pt-16 dark:border-darkmode-border dark:bg-darkmode-theme-light"
>
  <div class="container">
    <div class="row">
      {/* brand column */}
      <div class="mb-12 lg:col-4 lg:pr-10">
        <a href="/" aria-label="The Data Lakehouse Hub">
          <Image
            src={config.site.logo}
            width={Number(config.site.logo_width)}
            height={Number(config.site.logo_height)}
            alt={config.site.title}
            class="dark:brightness-0 dark:invert"
          />
        </a>

        <p
          class="mt-5 max-w-sm leading-relaxed text-text dark:text-darkmode-text"
          set:html={markdownify(footer_content)}
        />
        <Social source={social} className="social-icons mt-6" />
      </div>

      {/* link columns */}
      {
        menu.footer.map((col) => {
          return (
            <div class="mb-12 sm:col-6 lg:col-2">
              <h2
                class="font-secondary text-sm font-bold uppercase tracking-[0.14em] text-dark dark:text-darkmode-dark"
                set:html={markdownify(col.name)}
              />
              <ul class="mt-5 space-y-2.5">
                {col?.menu.map((item) => (
                  <li>
                    <a
                      href={item.url}
                      class="text-sm text-text transition-colors hover:text-primary dark:text-darkmode-text dark:hover:text-darkmode-primary"
                    >
                      {item.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>

    {/* Cross-network and community links. Rendered as inline runs rather than
        stacked column grids: same links, a fraction of the vertical space, and
        it drops six redundant sub-headings out of the footer outline. */}
    <nav
      class="border-t border-border pt-8 dark:border-darkmode-border"
      aria-label="The Alex Merced Network"
    >
      <h2
        class="font-secondary text-xs font-bold uppercase tracking-[0.14em] text-primary dark:text-darkmode-primary"
      >
        The Alex Merced Network
      </h2>
      <ul class="footer-run-list mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
        {
          menu.network.flatMap((col) => col.menu).map((item) => (
            <li class="footer-inline-item">
              <a
                href={item.url}
                target="_blank"
                rel="noopener"
                class="text-sm text-text transition-colors hover:text-primary dark:text-darkmode-text dark:hover:text-darkmode-primary"
              >
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav
      class="mt-8 border-t border-border pt-8 dark:border-darkmode-border"
      aria-label="Events and community"
    >
      <h2
        class="font-secondary text-xs font-bold uppercase tracking-[0.14em] text-primary dark:text-darkmode-primary"
      >
        Events &amp; Community
      </h2>
      <ul class="footer-run-list mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
        {
          menu.community.flatMap((col) => col.menu).map((item) => (
            <li class="footer-inline-item">
              <a
                href={item.url}
                target="_blank"
                rel="noopener"
                class="text-sm text-text transition-colors hover:text-primary dark:text-darkmode-text dark:hover:text-darkmode-primary"
              >
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* copyright */}
    <div class="border-t border-border py-8 dark:border-darkmode-border">
      <p
        class="text-center text-xs leading-relaxed text-text/80 dark:text-darkmode-text/80"
        set:html={markdownify(copyright)}
      />
    </div>
  </div>
</footer>
