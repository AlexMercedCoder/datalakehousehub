---
import Logo from "@/components/Logo.astro";
import { nav_button } from "@/config/config.json";
import menu from "@/config/menu.json";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import SearchModal from "@/components/SearchModal";

const pathname = new URL(Astro.request.url).pathname;

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

const { main }: { main: NavigationLink[] } = menu;
---

<header class="header">
  <nav class="navbar container">
    <!-- logo -->
    <div class="order-0">
      <Logo />
    </div>
    <input id="nav-toggle" type="checkbox" class="hidden" />

    <!-- utilities: pinned to the top row at every width so they never wrap
         underneath the nav. Subscribe lives in the menu below xl. -->
    <div
      class="order-1 ml-auto flex items-center gap-3 xl:order-2 xl:ml-0"
    >
      <div class="hidden md:block">
        <SearchModal client:load />
      </div>
      <ThemeSwitcher />
      {
        nav_button.enable && (
          <a
            class="btn btn-primary btn-sm hidden h-10 xl:inline-flex"
            href={nav_button.link}
          >
            {nav_button.label}
          </a>
        )
      }
    </div>

    <!-- navbar toggler -->
    <label
      id="show-button"
      for="nav-toggle"
      class="order-2 ml-3 flex cursor-pointer items-center xl:hidden"
    >
      <svg class="h-6 fill-current" viewBox="0 0 20 20">
        <title>Menu Open</title>
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
      </svg>
    </label>
    <label
      id="hide-button"
      for="nav-toggle"
      class="order-2 ml-3 cursor-pointer items-center xl:hidden"
    >
      <svg class="h-6 fill-current" viewBox="0 0 20 20">
        <title>Menu Close</title>
        <polygon
          points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
          transform="rotate(45 10 10)"></polygon>
      </svg>
    </label>
    <!-- /navbar toggler -->

    <ul
      id="nav-menu"
      class="navbar-nav order-3 hidden w-full xl:order-1 xl:flex xl:w-auto xl:space-x-1"
    >
      {
        main.map((menu, index) => (
          <>
            {menu.hasChildren ? (
              <li class="nav-item nav-dropdown group relative">
                <span class="nav-link inline-flex items-center cursor-pointer">
                  {menu.name}
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                  </svg>
                </span>
                {/* anchor the trailing menus to their right edge so a wide
                    dropdown never pushes past the viewport */}
                <ul
                  class={`nav-dropdown-list hidden group-hover:block xl:invisible xl:absolute xl:block xl:opacity-0 xl:group-hover:visible xl:group-hover:opacity-100 ${
                    index >= main.length - 2 ? "xl:right-0" : "xl:left-0"
                  }`}
                >
                  {menu.children?.map((child) => (
                    <li class="nav-dropdown-item">
                      <a
                        href={child.url}
                        class={`nav-dropdown-link block ${
                          pathname === child.url && "nav-link-active"
                        }`}
                      >
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="nav-item">
                <a
                  href={menu.url}
                  class={`nav-link block ${
                    pathname === menu.url && "nav-link-active"
                  }`}
                >
                  {menu.name}
                </a>
              </li>
            )}
          </>
        ))
      }
      {
        nav_button.enable && (
          <div class="block xl:hidden">
            <a
              class="btn btn-primary z-0 ml-auto py-[14px]"
              href={nav_button.link}
            >
              {nav_button.label}
            </a>
          </div>
        )
      }
    </ul>
  </nav>
</header>
