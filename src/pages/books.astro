---
import Base from "@/layouts/Base.astro";
import bookData from "@/data/books.json";

const { intro, books, count, totalInCatalog, catalog } = bookData;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Books by Alex Merced on the lakehouse and agentic analytics",
  numberOfItems: books.length,
  itemListElement: books.map((book, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Book",
      name: book.title,
      description: book.description,
      url: book.canonicalPage,
      author: { "@type": "Person", name: "Alex Merced", url: "https://alexmerced.com" },
    },
  })),
};
---

<Base
  title="Books by Alex Merced"
  description="Books on lakehouse architecture, Apache Iceberg, catalogs, semantic layers, and agentic analytics, written by Alex Merced."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="section pt-16">
    <div class="container">
      <div class="mb-12 max-w-3xl">
        <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-primary">Books by Alex Merced</p>
        <h1 class="mb-6 text-4xl font-bold lg:text-5xl">Read further</h1>
        <p class="mb-3 text-lg text-text dark:text-darkmode-text">{intro}</p>
        <p class="text-sm text-text dark:text-darkmode-text">
          {count} of {totalInCatalog} titles.
          <a class="text-primary underline" href={catalog} target="_blank" rel="noopener noreferrer">See the complete catalog</a>
        </p>
      </div>

      <ul class="row list-none pl-0">
        {books.map((book) => (
          <li class="mb-10 md:col-6 lg:col-4">
            <article class="flex h-full gap-5">
              <a
                href={book.canonicalPage}
                target="_blank"
                rel="noopener noreferrer"
                tabindex="-1"
                aria-hidden="true"
                class="w-24 shrink-0"
              >
                <img src={book.cover} alt="" loading="lazy" decoding="async" class="w-full rounded shadow-md" />
              </a>
              <div class="flex flex-col">
                <h2 class="mb-1 text-base font-semibold leading-snug">
                  <a class="hover:text-primary" href={book.canonicalPage} target="_blank" rel="noopener noreferrer">
                    {book.title}
                  </a>
                </h2>
                {book.publisher && (
                  <p class="mb-2 text-xs uppercase tracking-wide text-text dark:text-darkmode-text">{book.publisher}</p>
                )}
                <p class="mb-3 text-sm leading-relaxed text-text dark:text-darkmode-text">{book.description}</p>
                <p class="mt-auto flex flex-wrap gap-4 text-sm font-semibold">
                  <a class="text-primary hover:underline" href={book.canonicalPage} target="_blank" rel="noopener noreferrer">Details</a>
                  <a class="text-primary hover:underline" href={book.amazon} target="_blank" rel="noopener noreferrer">Buy on Amazon</a>
                </p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
