---
import Base from "@/layouts/Base.astro";
import KnowledgebaseSingle from "@/layouts/KnowledgebaseSingle.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { buildRelatedTerms } from "@/lib/utils/kbRelated";

export async function getStaticPaths() {
  const pages = await getSinglePage("knowledgebase");

  const relatedMap = buildRelatedTerms(pages as any[]);

  return pages.map((page: any) => {
    const related = relatedMap.get(page.id) || [];

    return {
      params: {
        slug: page.id,
      },
      props: { page, relatedTerms: related },
    };
  });
}

const { page, relatedTerms } = Astro.props;
const { title, meta_title, description, image, canonical } = page.data;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://datalakehousehub.com",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Knowledge Base",
      item: "https://datalakehousehub.com/knowledgebase",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
      item: `https://datalakehousehub.com/knowledgebase/${page.id}`,
    },
  ],
};

const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: title,
  description: description,
  inDefinedTermSet: "https://datalakehousehub.com/knowledgebase",
};
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  canonical={canonical}
>
  <script type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <KnowledgebaseSingle data={page} relatedTerms={relatedTerms} />
</Base>

