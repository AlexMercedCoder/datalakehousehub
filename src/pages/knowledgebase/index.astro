---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";

const posts = await getSinglePage("knowledgebase");
const sorted = [...posts].sort((a: any, b: any) =>
  a.data.title.localeCompare(b.data.title),
);
---

<Base
  title="Knowledge Base"
  meta_title="Data Lakehouse Knowledge Base | Glossary of Iceberg & Lakehouse Terms"
  description="A searchable glossary of data lakehouse, Apache Iceberg, catalog, and query engine terminology — plain-English definitions for practitioners."
>
  <section class="section pt-14">
    <div class="container">
      <div class="section-head !mb-10 !max-w-3xl">
        <span class="eyebrow">Reference</span>
        <h2 class="!text-4xl lg:!text-5xl">Knowledge Base</h2>
        <p>
          Plain-English definitions for the data lakehouse: {sorted.length} terms
          spanning Apache Iceberg, catalogs, table formats, query engines, and
          agentic AI.
        </p>
      </div>

      <div class="mx-auto mb-4 max-w-2xl">
        <div class="relative">
          <svg
            class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-text/50 dark:text-darkmode-text/50"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <input
            type="search"
            id="kb-search-input"
            placeholder="Search glossary terms and definitions..."
            aria-label="Search the knowledge base"
            class="w-full rounded-full border border-border bg-white py-3.5 pl-12 pr-4 text-text transition focus:border-primary focus:ring-primary dark:border-darkmode-border dark:bg-theme-dark dark:text-darkmode-dark"
          />
        </div>
        <p
          id="kb-count"
          class="mt-3 text-center text-sm text-text/70 dark:text-darkmode-text/70"
          aria-live="polite"
        >
          Showing all {sorted.length} terms
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" id="kb-grid">
        {
          sorted.map((post: any) => (
            <a
              href={`/knowledgebase/${post.id}`}
              class="surface surface-hover kb-card group flex flex-col p-6"
              data-title={post.data.title.toLowerCase()}
              data-desc={post.data.description?.toLowerCase() || ""}
            >
              <h3 class="font-secondary text-lg font-bold leading-snug text-dark transition-colors group-hover:text-primary dark:text-darkmode-dark dark:group-hover:text-darkmode-primary">
                {post.data.title}
              </h3>
              <p class="mt-3 line-clamp-4 flex-1 text-sm leading-relaxed text-text dark:text-darkmode-text">
                {post.data.description}
              </p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-primary dark:text-darkmode-primary">
                Read full definition
                <svg
                  class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>

      <p
        id="kb-empty"
        class="hidden py-16 text-center text-lg text-text dark:text-darkmode-text"
      >
        No terms match that search — try a broader keyword.
      </p>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById(
      "kb-search-input",
    ) as HTMLInputElement | null;
    const cards = document.querySelectorAll<HTMLElement>(".kb-card");
    const countEl = document.getElementById("kb-count");
    const emptyEl = document.getElementById("kb-empty");

    searchInput?.addEventListener("input", () => {
      const query = searchInput.value.trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const title = card.getAttribute("data-title") || "";
        const desc = card.getAttribute("data-desc") || "";
        const match = !query || title.includes(query) || desc.includes(query);
        card.classList.toggle("hidden", !match);
        if (match) visible++;
      });

      if (countEl) {
        countEl.textContent = query
          ? `${visible} ${visible === 1 ? "term" : "terms"} matching "${searchInput.value.trim()}"`
          : `Showing all ${cards.length} terms`;
      }
      emptyEl?.classList.toggle("hidden", visible !== 0);
    });
  </script>
</Base>
