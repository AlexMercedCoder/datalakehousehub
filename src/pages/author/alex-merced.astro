import Base from "@/layouts/Base.astro";
---

<Base title="Alex Merced — Open Lakehouse & AI Advocate, Author & Technologist" description="Alex Merced writes and speaks about the open data lakehouse, Apache Iceberg, and agentic analytics — and co-created 'Apache Iceberg: The Definitive Guide.'">
  <section class="section pt-16">
    <div class="container max-w-4xl mx-auto">
      <div class="row items-center mb-12">
        <div class="col-12 sm:col-4 mb-8 sm:mb-0 text-center sm:text-left">
          <img
            src="/images/alexmercedpic.jpg"
            alt="Alex Merced"
            class="rounded-full w-48 h-48 object-cover mx-auto sm:mx-0 shadow-lg border-4 border-white"
            onerror="this.src='https://ui-avatars.com/api/?name=Alex+Merced&size=256&background=0D8ABC&color=fff'"
          />
        </div>
        <div class="col-12 sm:col-8">
          <h1 class="text-4xl font-bold mb-4">Alex Merced</h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 mb-6">
            Open Lakehouse & AI Advocate · Author · Technologist
          </p>
          <div class="flex flex-wrap gap-4 justify-center sm:justify-start">
            <a href="https://twitter.com/alexmercedcoder" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary">Twitter</a>
            <a href="https://www.linkedin.com/in/alexmerced" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary">LinkedIn</a>
            <a href="https://books.alexmerced.com" target="_blank" rel="noopener noreferrer" class="btn btn-primary">My Books</a>
            <a href="https://whoisalexmerced.com" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary">My Story</a>
          </div>
        </div>
      </div>

      <div class="content">
        <h2>About Me</h2>
        <p>
          I grew up in Hartford, Connecticut — son of a Guatemalan mother and a Puerto Rican father — and came to technology by an unusual route. I spend my time now on the open data lakehouse: Apache Iceberg, open catalogs, and where analytics meets agentic AI. Mostly I like taking something that looks intimidating and making it click for the person in front of me.
        </p>

        <h3>From Economics to Engineering</h3>
        <p>
          For over a decade in New York City I taught economics and finance to working professionals at Greico Financial Training — standing in front of a room every day figuring out how to make dense material land. In 2019 I moved into software full-time, first as a full-stack developer and then teaching at the General Assembly bootcamp.
        </p>
        <p>
          These days I lead developer relations at Dremio, where I work on Apache Iceberg and Apache Polaris and spend most of my week helping engineers get their hands dirty with the lakehouse. You'll also find me on stage at conferences like Data Council, Data Day Texas, Confluent Current, and DataEngBytes.
        </p>

        <h2>Published Books</h2>
        <p>
          I've written or co-written more than 35 books across tech, economics, and fiction. A few that engineers reach for most:
        </p>
        <ul>
          <li><strong>Apache Iceberg: The Definitive Guide:</strong> Co-authored — one of the first full books on the format.</li>
          <li><strong>Apache Polaris: The Definitive Guide:</strong> A working guide to open catalog federation.</li>
          <li><strong>Architecting an Apache Iceberg Lakehouse:</strong> How to build multi-engine lakehouses that hold up in production.</li>
          <li><strong>Lakehouse for Everyone:</strong> A plain-English on-ramp to the open data lakehouse.</li>
          <li><strong>Agentic Analytics:</strong> What changes when AI agents start doing the analysis.</li>
        </ul>
        <p>
          You can explore my complete library of works at <a href="http://books.alexmerced.com" target="_blank" rel="noopener noreferrer">books.alexmerced.com</a>.
        </p>

        <h2>Technical Focus</h2>
        <p>
          My technical research and writings focus on:
        </p>
        <ul>
          <li><strong>Open Table Formats:</strong> Apache Iceberg, Delta Lake, Apache Hudi.</li>
          <li><strong>Agentic Architecture:</strong> The Model Context Protocol (MCP), Semantic Layers, and LLM Orchestration.</li>
          <li><strong>Distributed Query Engines:</strong> Dremio, Trino, Apache Spark, and Apache DataFusion.</li>
          <li><strong>Metadata Federation:</strong> Apache Polaris, REST Catalogs, and Apache Gravitino.</li>
        </ul>

        <h2>How this site is written</h2>
        <p>
          Everything here comes out of hands-on work — building on this stuff, teaching it, and writing about it. I test the code and the architectures against how these systems actually behave in production, and I'd rather flag a caveat than oversell a pattern.
        </p>
      </div>
    </div>
  </section>
</Base>
