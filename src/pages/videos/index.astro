---
// /videos — the Data Lakehouse Hub video explainer gallery.
// Animated 16:9 explainers rendered from a shared HyperFrames template: no
// narration and no audio track at all, so every point is on screen. The
// manifest is generated by the video workspace's sync-to-site.mjs
// (~/development/datalakehousehub-videos).
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";
import videos from "@/data/videos.json";

const BASE = config.site.base_url;
const canonicalURL = `${BASE}/videos`;
const abs = (p: string) => `${BASE}${p}`;

const title = "Data Lakehouse Video Explainers";
const description =
  "Short animated explainers on the data lakehouse: OLTP vs OLAP, the data warehouse, the lakehouse evolution, Apache Parquet, open table formats, Apache Polaris, agentic AI, semantic layers and Apache Arrow.";

// The date this gallery was first published. VideoObject requires uploadDate.
const UPLOAD_DATE = "2026-08-08T00:00:00+00:00";

const publisher = {
  "@type": "Organization",
  name: config.site.title,
  url: `${BASE}/`,
};

const creator = {
  "@type": "Person",
  name: config.metadata.meta_author,
  url: `${BASE}/author/alex-merced`,
};

const videoSchemas = videos.map((v) => ({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "@id": `${canonicalURL}#${v.slug}`,
  name: v.title,
  description: v.description,
  thumbnailUrl: [abs(v.poster)],
  uploadDate: UPLOAD_DATE,
  duration: v.iso8601,
  contentUrl: abs(v.src),
  encodingFormat: "video/mp4",
  width: v.width,
  height: v.height,
  inLanguage: "en",
  isFamilyFriendly: true,
  keywords: v.keywords.join(", "),
  creator,
  publisher,
}));

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${canonicalURL}#collection`,
  name: title,
  description,
  url: canonicalURL,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: videos.length,
    itemListElement: videos.map((v, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `${canonicalURL}#${v.slug}`,
      name: v.title,
    })),
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${BASE}/` },
    { "@type": "ListItem", position: 2, name: "Videos", item: canonicalURL },
  ],
};

const fmt = (s: number) =>
  `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
---

<Base {title} {description} canonical={canonicalURL}>
  {
    videoSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }
  <script
    type="application/ld+json"
    set:html={JSON.stringify(collectionSchema)}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <section class="section pt-12">
    <div class="container">
      <nav class="video-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Videos</span>
      </nav>

      <header class="video-hero">
        <p class="video-eyebrow">Video explainers</p>
        <h1 class="video-title">
          The data lakehouse, explained in under a minute each
        </h1>
        <p class="video-lede">
          Nine short animated explainers covering the ideas that come up first
          when teams move analytics onto a lakehouse — from why OLTP and OLAP
          split apart, through Parquet, table formats and catalogs, to semantic
          layers and agentic AI. There is no narration and no audio track at
          all: every point is on screen, so they read exactly the same muted,
          in a meeting, or embedded in your own docs.
        </p>
      </header>

      {
        videos.length === 0 ? (
          <p class="video-empty">
            Videos are being published — check back shortly.
          </p>
        ) : (
          <ul class="video-grid" role="list">
            {videos.map((v) => (
              <li class="video-card" id={v.slug}>
                <div class="video-frame">
                  <video
                    class="video-el"
                    controls
                    playsinline
                    muted
                    preload="metadata"
                    poster={v.poster}
                    width={v.width}
                    height={v.height}
                    aria-label={`${v.title} — silent animated explainer, ${fmt(v.seconds)}`}
                  >
                    <source src={v.src} type="video/mp4" />
                    Your browser does not support the video tag.
                    <a href={v.src}>Download the MP4</a>.
                  </video>
                  <span class="video-duration" aria-hidden="true">
                    {fmt(v.seconds)}
                  </span>
                </div>

                <div class="video-body">
                  <h2 class="video-name">
                    <span class="video-index">
                      {String(v.index).padStart(2, "0")}
                    </span>
                    {v.title}
                  </h2>
                  <p class="video-caption">{v.description}</p>
                  <ul class="video-points" role="list">
                    {v.beats.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))}
          </ul>
        )
      }

      <p class="video-note">
        Silent by design — no narration, no music. Hover to preview, click to
        play, or download any MP4 and reuse it.
      </p>
    </div>
  </section>
</Base>

<style lang="scss">
  .video-breadcrumb {
    @apply mb-6 flex items-center gap-2 text-sm text-text opacity-70 dark:text-gray-400;

    a:hover {
      @apply text-primary opacity-100;
    }
  }

  .video-hero {
    @apply mb-14 max-w-3xl;
  }
  .video-eyebrow {
    @apply mb-3 text-xs font-bold uppercase tracking-[0.18em] text-primary;
  }
  .video-title {
    @apply text-3xl font-bold leading-tight text-dark dark:text-white lg:text-4xl;
  }
  .video-lede {
    @apply mt-5 text-base leading-relaxed text-text dark:text-gray-300 lg:text-lg;
  }

  .video-grid {
    @apply grid grid-cols-1 gap-10 md:grid-cols-2;
  }
  .video-card {
    @apply flex flex-col overflow-hidden rounded-xl border border-border bg-white transition-shadow dark:border-gray-700 dark:bg-gray-900;

    &:hover {
      @apply shadow-[0_12px_30px_-12px_rgba(10,168,167,0.45)];
    }
  }

  .video-frame {
    // aspect-video is Tailwind's 16/9 — written as a utility so Sass never sees
    // a bare `16 / 9` and tries to treat the slash as division.
    @apply relative aspect-video w-full bg-[#04100f];
  }
  .video-el {
    @apply absolute inset-0 block h-full w-full;
  }
  .video-duration {
    @apply pointer-events-none absolute right-2 top-2 rounded bg-black/65 px-2 py-1 text-xs font-bold text-white;
  }

  .video-body {
    @apply flex flex-1 flex-col p-6;
  }
  .video-name {
    @apply flex items-baseline gap-2 text-lg font-bold leading-snug text-dark dark:text-white;
  }
  .video-index {
    @apply text-sm font-bold text-primary;
  }
  .video-caption {
    @apply mt-3 text-sm leading-relaxed text-text dark:text-gray-300;
  }
  .video-points {
    @apply mt-4 flex flex-col gap-2 border-t border-border pt-4 dark:border-gray-700;

    li {
      @apply relative pl-4 text-sm text-text opacity-80 dark:text-gray-400;

      &::before {
        content: "";
        @apply absolute left-0 top-[0.62em] h-px w-2 bg-primary;
      }
    }
  }

  .video-note {
    @apply mt-12 text-center text-sm text-text opacity-70 dark:text-gray-400;
  }
  .video-empty {
    @apply py-12 text-center text-text dark:text-gray-300;
  }
</style>

<script>
  // The clips carry no audio track, so a muted hover-preview costs the viewer
  // nothing and autoplay policies never block it. Three behaviours only:
  //   1. hover (fine-pointer devices only) previews from the start;
  //   2. leaving resets to the poster, unless the viewer pressed play;
  //   3. starting one video pauses whichever one was already going.
  function setupVideoGallery() {
    const videos = Array.from(
      document.querySelectorAll<HTMLVideoElement>(".video-el"),
    );
    if (!videos.length) return;

    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)")
      .matches;
    const intentional = new WeakSet<HTMLVideoElement>();

    videos.forEach((video) => {
      video.addEventListener("play", () => {
        videos.forEach((other) => {
          if (other !== video && !other.paused) other.pause();
        });
      });

      // A click on the native controls is a deliberate play — stop treating
      // this element as a hover preview from then on.
      video.addEventListener("click", () => intentional.add(video));

      if (!canHover) return;

      video.addEventListener("mouseenter", () => {
        if (intentional.has(video)) return;
        video.currentTime = 0;
        void video.play().catch(() => {});
      });

      video.addEventListener("mouseleave", () => {
        if (intentional.has(video)) return;
        video.pause();
        video.currentTime = 0;
      });
    });
  }

  setupVideoGallery();
  document.addEventListener("astro:after-swap", setupVideoGallery);
</script>
