---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Cta from "@/layouts/components/Cta.astro";
import Post from "@/layouts/partials/Post.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { markdownify } from "@/lib/utils/textConverter";
import { getEntry } from "astro:content";

const homepage = await getEntry("homepage", "index");
const { banner, feature, workflow, call_to_action } = homepage.data;

const posts = await getSinglePage("blog");
const sortedPosts = sortByDate(posts);
const recentPosts = sortedPosts.slice(0, 3);

const kbTerms = await getSinglePage("knowledgebase");

// Rounded-down counts so the numbers stay honest as content grows.
const floorTo = (n: number, step: number) => Math.floor(n / step) * step;

const stats = [
  { value: `${floorTo(posts.length, 50)}+`, label: "Articles & tutorials" },
  { value: `${floorTo(kbTerms.length, 50)}+`, label: "Glossary entries" },
  { value: "5", label: "Free lakehouse books" },
  { value: "Weekly", label: "Newsletter & roundups" },
];

// The four things a first-time visitor should be able to reach in one click.
const destinations = [
  {
    title: "Knowledge Base",
    description:
      "A searchable glossary of lakehouse, Iceberg, and catalog terminology.",
    href: "/knowledgebase",
    icon: "book",
  },
  {
    title: "The Blog",
    description:
      "Tutorials, architecture deep dives, and ecosystem news, published weekly.",
    href: "/blog",
    icon: "pen",
  },
  {
    title: "Video Explainers",
    description:
      "Short, focused walkthroughs of the concepts that are hard to read about.",
    href: "/videos",
    icon: "play",
  },
  {
    title: "Events Calendar",
    description:
      "Meetups, webinars, and Lakehouse Linkups happening across the community.",
    href: "/events",
    icon: "calendar",
  },
];

// Curated evergreen reading. The first entry gets the featured treatment.
const mustReads = [
  {
    category: "Apache Iceberg",
    title: "What is Apache Iceberg? The Table Format Revolution",
    description:
      "Learn how Apache Iceberg turned raw Parquet files in S3 into a fully ACID-compliant, time-traveling analytical database without moving your data out of object storage.",
    href: "/blog/2026-04-apache-iceberg",
  },
  {
    category: "Agentic AI",
    title: "Agentic Analytics on the Apache Lakehouse",
    description:
      "How autonomous AI agents replace manual dashboard querying by reading governed semantic layers directly on your data lakehouse.",
    href: "/blog/2026-04-agentic-analytics",
  },
  {
    category: "Ecosystem",
    title: "The 2025 State of the Apache Iceberg Ecosystem",
    description:
      "Survey data from data professionals on adoption rates, popular tooling, and where the ecosystem is heading through 2026.",
    href: "/blog/2026-02-state-of-the-apache-iceberg-ecosystem",
  },
  {
    category: "Data Lakehouse",
    title: "What Are Table Formats and Why Were They Needed?",
    description:
      "Table formats solved the ACID, schema evolution, and query performance problems that turned data lakes into unmanageable swamps.",
    href: "/blog/2026-04-29-apache-iceberg-masterclass-01-table-formats",
  },
  {
    category: "Apache Iceberg",
    title: "2026 Intro to Apache Iceberg",
    description:
      "A beginner-to-intermediate introduction covering the metadata layer, catalog integrations, and why Iceberg became the dominant table format.",
    href: "/blog/2026-02-2026-Intro-to-Apache-Iceberg",
  },
  {
    category: "Agentic AI",
    title: "Why AI Fails Without a Semantic Layer",
    description:
      "The business context and governed metrics AI agents need to generate accurate, trustworthy analytical answers at scale.",
    href: "/blog/2026-02-semantic-layer-05-why-ai-fails-without",
  },
];

const [featuredRead, ...secondaryReads] = mustReads;
---

<Base
  title="The Data Lakehouse Hub"
  meta_title="Data Lakehouse Hub | News, Community, Apache Iceberg & Lakehouse Architecture"
  description="News, newsletters, and community for the data lakehouse ecosystem. Weekly roundups, deep dives into Apache Iceberg, and expert guides from practitioners."
  canonical="https://datalakehousehub.com/"
>
  <!-- ───────────────────────── Hero ───────────────────────── -->
  <section
    class="relative overflow-hidden border-b border-border bg-theme-light/60 dark:border-darkmode-border dark:bg-darkmode-theme-light/40"
  >
    <!-- blueprint grid + ambient glow -->
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-70"></div>
    <div
      class="pointer-events-none absolute -left-40 -top-40 h-[520px] w-[520px] rounded-full bg-primary-bright/25 blur-[130px] animate-float-slow dark:bg-darkmode-primary/20"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-56 -right-32 h-[460px] w-[460px] rounded-full bg-accent/20 blur-[130px] dark:bg-darkmode-accent/10"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-body to-transparent dark:from-darkmode-body"
    >
    </div>

    <!-- knowledge-graph corners -->
    <svg class="hub-graph" viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="dlh-fade" gradientUnits="userSpaceOnUse" cx="720" cy="620" r="1020">
          <stop offset="0" stop-color="#000"/>
          <stop offset="0.72" stop-color="#000"/>
          <stop offset="1" stop-color="#fff"/>
        </radialGradient>
        <mask id="dlh-mask"><rect width="1440" height="1000" fill="url(#dlh-fade)"/></mask>
      </defs>

      <g mask="url(#dlh-mask)">
        <g class="hub-edges">
          <path d="M-40 180 L110 240 L60 370 L200 420"/>
          <path d="M110 240 L250 210"/>
          <path d="M60 370 L-30 450"/>
          <path d="M1480 190 L1330 250 L1380 370 L1240 420"/>
          <path d="M1330 250 L1190 220"/>
          <path d="M1380 370 L1470 460"/>
          <path d="M-40 820 L120 760 L70 640 L220 590"/>
          <path d="M120 760 L260 810"/>
          <path d="M1480 810 L1320 750 L1370 630 L1220 585"/>
          <path d="M1320 750 L1180 800"/>
        </g>

        <g class="hub-signals">
          <path pathLength="100" d="M-40 180 L110 240 L60 370 L200 420" style="animation-duration:9s"/>
          <path pathLength="100" d="M1480 190 L1330 250 L1380 370 L1240 420" style="animation-duration:11s;animation-delay:-4s"/>
          <path pathLength="100" d="M-40 820 L120 760 L70 640 L220 590" style="animation-duration:10s;animation-delay:-6s"/>
          <path pathLength="100" d="M1480 810 L1320 750 L1370 630 L1220 585" style="animation-duration:12s;animation-delay:-2s"/>
        </g>

        <g class="hub-nodes">
          <circle cx="110" cy="240" r="6"/>
          <circle cx="60" cy="370" r="5" style="animation-delay:-1.4s"/>
          <circle cx="1330" cy="250" r="6" style="animation-delay:-2.1s"/>
          <circle cx="1380" cy="370" r="5" style="animation-delay:-3.3s"/>
          <circle cx="120" cy="760" r="6" style="animation-delay:-0.7s"/>
          <circle cx="70" cy="640" r="5" style="animation-delay:-2.8s"/>
          <circle cx="1320" cy="750" r="6" style="animation-delay:-1.9s"/>
          <circle cx="1370" cy="630" r="5" style="animation-delay:-3.9s"/>
        </g>
        <g class="hub-nodes hub-nodes--accent">
          <circle cx="200" cy="420" r="7" style="animation-delay:-1.1s"/>
          <circle cx="1240" cy="420" r="7" style="animation-delay:-2.6s"/>
          <circle cx="220" cy="590" r="7" style="animation-delay:-3.5s"/>
          <circle cx="1220" cy="585" r="7" style="animation-delay:-0.4s"/>
        </g>
      </g>
    </svg>

    <div class="container relative pt-16 pb-20 lg:pt-24 lg:pb-28">
      <div class="row items-center gap-y-12">
        <div class="lg:col-6">
          <span class="badge">
            <span
              class="h-1.5 w-1.5 animate-pulse rounded-full bg-primary dark:bg-darkmode-primary"
            ></span>
            Independent · Practitioner-run
          </span>

          <h1
            class="mt-6 font-secondary text-4xl font-bold leading-[1.08] tracking-tight text-dark dark:text-darkmode-dark lg:text-[3.6rem]"
          >
            {banner?.title}
          </h1>

          {
            banner?.content && (
              <p
                class="mt-6 max-w-xl text-lg leading-relaxed text-text dark:text-darkmode-text"
                set:html={markdownify(banner.content)}
              />
            )
          }

          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
            {
              banner?.button?.enable && (
                <a class="btn btn-primary" href={banner.button.link}>
                  {banner.button.label}
                </a>
              )
            }
            <a class="btn btn-outline-primary" href="/knowledgebase">
              Explore Knowledge Base
            </a>
          </div>

          <!-- credibility strip -->
          <dl
            class="mt-12 grid max-w-xl grid-cols-2 gap-x-6 gap-y-6 border-t border-border pt-8 dark:border-darkmode-border sm:grid-cols-4"
          >
            {
              stats.map((stat) => (
                <div>
                  <dt class="font-secondary text-2xl font-bold text-dark dark:text-darkmode-dark">
                    {stat.value}
                  </dt>
                  <dd class="mt-1 text-xs font-semibold uppercase tracking-wider text-text/80 dark:text-darkmode-text/80">
                    {stat.label}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        {
          banner?.image && (
            <div class="lg:col-6">
              <div class="relative mx-auto max-w-[620px]">
                <div class="absolute -inset-4 rounded-[28px] bg-gradient-to-tr from-primary/25 via-transparent to-accent/25 blur-2xl dark:from-darkmode-primary/25 dark:to-darkmode-accent/20" />
                <Image
                  class="surface relative w-full rounded-2xl p-2 shadow-[0_28px_70px_-30px_rgba(16,28,40,.55)]"
                  src={banner?.image}
                  width={850}
                  height={442}
                  alt="The Data Lakehouse Hub"
                  loading="eager"
                />
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ─────────────────── Start here / destinations ─────────────────── -->
  <section class="section-sm">
    <div class="container">
      <div
        class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <span class="eyebrow">Start here</span>
          <h2 class="mt-2 text-2xl lg:text-3xl">Find your way around</h2>
        </div>
        <p class="max-w-md text-text dark:text-darkmode-text sm:text-right">
          Four ways into the Hub — reference, reading, watching, and meeting
          people.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          destinations.map((item) => (
            <a
              href={item.href}
              class="surface surface-hover group flex flex-col p-6"
            >
              <span class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-white dark:bg-darkmode-primary/10 dark:text-darkmode-primary dark:group-hover:bg-darkmode-primary dark:group-hover:text-darkmode-body">
                {item.icon === "book" && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                  </svg>
                )}
                {item.icon === "pen" && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z" />
                  </svg>
                )}
                {item.icon === "play" && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="2" y="4" width="20" height="16" rx="3" />
                    <path d="m10 9 5 3-5 3z" />
                  </svg>
                )}
                {item.icon === "calendar" && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M16 3v4M8 3v4M3 11h18" />
                  </svg>
                )}
              </span>
              <h3 class="font-secondary text-lg font-bold text-dark transition-colors group-hover:text-primary dark:text-darkmode-dark dark:group-hover:text-darkmode-primary">
                {item.title}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-text dark:text-darkmode-text">
                {item.description}
              </p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-primary dark:text-darkmode-primary">
                Browse
                <svg
                  class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Latest posts ───────────────────────── -->
  <section class="section band">
    <div class="container">
      <div
        class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <span class="eyebrow">Fresh off the press</span>
          <h2 class="mt-3 text-3xl lg:text-4xl">Latest Posts</h2>
        </div>
        <a
          href="/blog"
          class="group inline-flex items-center gap-1.5 font-semibold text-primary dark:text-darkmode-primary"
        >
          View all posts
          <svg
            class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {recentPosts.map((post) => <Post post={post} />)}
      </div>
    </div>
  </section>

  <!-- ─────────────────────── Must read articles ─────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Start with these</span>
        <h2>Must Read Articles</h2>
        <p>
          Deep dives into Apache Iceberg, agentic AI, and modern data lakehouse
          architecture by Alex Merced.
        </p>
      </div>

      <div class="grid gap-6 lg:grid-cols-12">
        <!-- featured -->
        <a
          href={featuredRead.href}
          class="group relative flex flex-col justify-end overflow-hidden rounded-2xl bg-dark p-8 text-white transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_28px_60px_-25px_rgba(16,28,40,.7)] lg:col-span-5 lg:p-10 dark:bg-theme-dark dark:border dark:border-darkmode-border"
        >
          <div
            class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-primary-bright/30 blur-3xl transition-all duration-500 group-hover:bg-primary-bright/40"
          >
          </div>
          <div class="grid-bg absolute inset-0 opacity-30"></div>
          <div class="relative">
            <span
              class="inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.16em] text-white ring-1 ring-inset ring-white/20"
            >
              {featuredRead.category}
            </span>
            <h3
              class="mt-6 font-secondary text-2xl font-bold leading-snug text-white lg:text-3xl"
            >
              {featuredRead.title}
            </h3>
            <p class="mt-4 leading-relaxed text-white/75">
              {featuredRead.description}
            </p>
            <span
              class="mt-8 inline-flex items-center gap-2 font-semibold text-primary dark:text-darkmode-primary"
            >
              Read article
              <svg
                class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </span>
          </div>
        </a>

        <!-- the rest -->
        <div class="grid gap-5 sm:grid-cols-2 lg:col-span-7">
          {
            secondaryReads.map((item) => (
              <a
                href={item.href}
                class="surface surface-hover group flex flex-col p-6"
              >
                <span class="eyebrow text-[11px]">{item.category}</span>
                <h3 class="mt-3 font-secondary text-lg font-bold leading-snug text-dark transition-colors group-hover:text-primary dark:text-darkmode-dark dark:group-hover:text-darkmode-primary">
                  {item.title}
                </h3>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-text dark:text-darkmode-text">
                  {item.description}
                </p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-primary dark:text-darkmode-primary">
                  Read article
                  <svg
                    class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ──────────────────────── Why a lakehouse ──────────────────────── -->
  <section class="section band">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The case for open architecture</span>
        <h2 set:html={markdownify(feature!.title)} />
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          feature!.features.map((item: any, i: number) => (
            <div class="surface surface-hover relative overflow-hidden p-8">
              <span class="absolute right-6 top-5 font-secondary text-5xl font-bold text-dark/[0.05] dark:text-white/5">
                {String(i + 1).padStart(2, "0")}
              </span>
              {item.icon && (
                <div class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10 dark:bg-darkmode-primary/10">
                  <img alt="" src={item.icon} width={28} height={28} />
                </div>
              )}
              <h3
                class="font-secondary text-xl font-bold text-dark dark:text-darkmode-dark"
                set:html={markdownify(item!.name)}
              />
              <p class="mt-3 leading-relaxed text-text dark:text-darkmode-text">
                {item.content}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─────────────────────────── Mission ─────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="row items-center gap-y-10">
        <div class="lg:col-5">
          <span class="eyebrow">About the Hub</span>
          <h2 class="mt-3 text-3xl lg:text-4xl" set:html={workflow?.title} />
          <p
            class="mt-5 text-lg leading-relaxed text-text dark:text-darkmode-text"
            set:html={workflow?.description}
          />
          <a href="/author/alex-merced" class="btn btn-outline-primary btn-sm mt-8">
            Meet the author
          </a>
        </div>
        <div class="lg:col-7">
          <div class="relative">
            <div
              class="absolute -inset-3 rounded-3xl bg-gradient-to-br from-primary/15 to-transparent blur-xl dark:from-darkmode-primary/15"
            >
            </div>
            <Image
              src={workflow!.image}
              alt="How the modern open data stack fits together"
              width={1920}
              height={414}
              class="surface relative w-full rounded-2xl p-3"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────────────────────── Reading list ──────────────────────── -->
  <section
    class="section relative overflow-hidden bg-dark dark:bg-darkmode-theme-light"
  >
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-25"></div>
    <div
      class="pointer-events-none absolute -right-40 top-1/4 h-[420px] w-[420px] rounded-full bg-primary-bright/25 blur-[120px]"
    >
    </div>
    <div class="container relative">
      <div class="section-head">
        <span class="eyebrow">Free to read</span>
        <h2 class="!text-white">{homepage.data.reading_list?.title}</h2>
        <p class="!text-white/70">
          Full-length books on Apache Iceberg, Apache Polaris, and lakehouse
          architecture — no paywall.
        </p>
      </div>
      <div
        class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5 lg:gap-6"
      >
        {
          homepage.data.reading_list?.books.map((book: any) => (
            <a
              href={book.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group block"
            >
              <div class="relative overflow-hidden rounded-lg shadow-[0_18px_40px_-18px_rgba(0,0,0,.8)] transition-all duration-300 group-hover:-translate-y-2 group-hover:shadow-[0_26px_50px_-18px_rgba(10,168,167,.55)]">
                <Image
                  src={book.image}
                  alt={book.title}
                  width={300}
                  height={450}
                  class="aspect-[2/3] w-full object-cover"
                />
                <span class="absolute inset-y-0 left-0 w-[6px] bg-gradient-to-r from-black/40 to-transparent" />
                <span class="absolute inset-0 bg-primary/0 transition-colors duration-300 group-hover:bg-primary-bright/10" />
              </div>
              <h3 class="mt-4 font-secondary text-sm font-semibold leading-snug text-white/90 transition-colors group-hover:text-primary-bright">
                {book.title}
              </h3>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─────────────────────────── Call to action ─────────────────────────── -->
  <Cta cta={call_to_action} />
</Base>
